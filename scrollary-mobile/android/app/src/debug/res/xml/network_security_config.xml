<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. The deterministic fixture site in `tool/fixture/` is served
  in-process over plain HTTP on the loopback address, which Android blocks by
  default from API 28 on. This file re-permits it for that address and nothing
  else, and it lives in the `debug` source set so no shipped build carries it.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
