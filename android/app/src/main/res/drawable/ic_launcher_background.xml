<?xml version="1.0" encoding="utf-8"?>
<!-- The adaptive icon's background layer: the same teal gradient the generated
     raster mark carries (tool/brand/generate_brand_assets.swift), as a vector
     so the launcher can mask and parallax it without resampling. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#21444E"
        android:startColor="#3E6D7E"
        android:type="linear" />
</shape>
