<?xml version="1.0" encoding="utf-8"?>
<!-- The window the OS shows while the process starts. It draws the app mark on
     the app's own page colour (@color/launch_background, night-aware), so the
     Flutter splash that replaces it continues the same image rather than
     cutting to it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
