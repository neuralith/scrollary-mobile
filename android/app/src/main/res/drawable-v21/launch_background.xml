<?xml version="1.0" encoding="utf-8"?>
<!-- Same as drawable/launch_background.xml. The app's page colour is used
     rather than ?android:colorBackground: the launch window must match the
     Flutter splash exactly, not the platform's idea of a background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_mark" />
    </item>
</layer-list>
